{
  "name": "cloudtoggle.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "wp:build": "astro build && node scripts/build-wp-content.mjs && tailwindcss -i wordpress/src/theme.css -o wordpress/cloudtoggle/assets/css/theme.css --minify && mkdir -p wordpress/dist && rm -f wordpress/dist/cloudtoggle-theme.zip && (cd wordpress && zip -rq dist/cloudtoggle-theme.zip cloudtoggle -x '*.DS_Store')",
    "wp:test": "npx @wp-playground/cli@latest server --blueprint=wordpress/dev/blueprint.json --mount-before-install=./wordpress/cloudtoggle:/wordpress/wp-content/themes/cloudtoggle --mount-before-install=./wordpress/page-content:/wordpress/page-content-src --port=9400"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
