---
import { Image } from 'astro:assets';
import aws from '../assets/logos/aws.png';
import azure from '../assets/logos/azure.png';

const providers = [
	{ name: 'Amazon Web Services', src: aws, height: 36 },
	{ name: 'Microsoft Azure', src: azure, height: 30 },
];
---

<section class="border-y border-ink-100 bg-ink-50/60" aria-label="Supported cloud platforms">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 py-12 sm:px-8" data-reveal>
		<p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-500">CLOUD TOGGLE works with</p>
		<ul class="flex flex-wrap items-center justify-center gap-4">
			{providers.map((p) => (
				<li class="flex h-20 w-48 items-center justify-center rounded-xl border border-ink-100 bg-white shadow-card transition duration-300 hover:-translate-y-0.5 hover:border-brand-200 sm:w-56">
					<Image src={p.src} alt={p.name} height={p.height * 2} class="w-auto" style={`height: ${p.height}px`} />
				</li>
			))}
		</ul>
	</div>
</section>
