---
import { Image } from 'astro:assets';
import aws from '../assets/logos/aws.png';
import azure from '../assets/logos/azure.png';
---

<section class="border-y border-ink-100 bg-ink-50/60" aria-label="Supported cloud platforms">
	<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-5 py-9 sm:flex-row sm:px-8" data-reveal>
		<p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-500">CLOUD TOGGLE works with</p>
		<div class="flex items-center gap-12">
			<Image src={aws} alt="Amazon Web Services" height={40} class="h-9 w-auto opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0" />
			<Image src={azure} alt="Microsoft Azure" height={40} class="h-9 w-auto opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0" />
		</div>
	</div>
</section>
