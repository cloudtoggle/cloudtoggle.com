---
import SectionHeading from './SectionHeading.astro';
import { LINKS } from '../data/site';

const steps = [
	{
		n: '01',
		title: 'Connect Your Cloud',
		body: 'Add an AWS or Azure connection with a guided wizard. Your servers are imported automatically, so there is nothing to install.',
		link: { label: 'Read the setup guides', href: LINKS.help },
		icon: 'M4 14a4 4 0 0 1 .9-7.9A5.5 5.5 0 0 1 15.6 5 4.5 4.5 0 0 1 16 14H4Zm6-2V8m0 0 2 2m-2-2-2 2',
	},
	{
		n: '02',
		title: 'Create Schedules',
		body: 'Set the daily and weekly hours each server is needed, in your time zone, and assign the schedule to as many servers as you like.',
		icon: 'M3 5.5h14M3 10h14M3 14.5h14M7 3v14M13 3v14',
	},
	{
		n: '03',
		title: 'Start Saving',
		body: 'Servers power off outside the hours you chose and back on when they are needed. Override any schedule in seconds when plans change.',
		icon: 'M10 3v7m4.2-4.2a6 6 0 1 1-8.4 0',
	},
];
---

<section id="how-it-works" class="py-24 sm:py-28">
	<div class="mx-auto max-w-6xl px-5 sm:px-8">
		<SectionHeading eyebrow="How it works" title="Live in minutes, saving from the first night." lead="Three steps. No agents to install and no scripts to maintain." />

		<ol class="relative mt-14 grid gap-5 md:grid-cols-3">
			{steps.map((s, i) => (
				<li class="group relative flex flex-col rounded-2xl border border-ink-100 bg-white p-7 shadow-card transition duration-300 hover:-translate-y-1 hover:border-brand-200" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
					<div class="flex items-center justify-between">
						<span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-brand-100">
							<svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
						</span>
						<span class="font-mono text-sm text-ink-400">{s.n}</span>
					</div>
					<h3 class="mt-6 text-xl font-semibold tracking-tight text-ink-950">{s.title}</h3>
					<p class="mt-3 leading-7 text-ink-500">{s.body}</p>
					{s.link && (
						<a href={s.link.href} rel="noopener" class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:text-brand-700">
							{s.link.label} <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
						</a>
					)}
				</li>
			))}
		</ol>
	</div>
</section>
