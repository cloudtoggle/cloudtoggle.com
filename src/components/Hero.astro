---
import Button from './Button.astro';
import BrowserFrame from './BrowserFrame.astro';
import scheduler from '../assets/screens/cloudtoggle-scheduler.png';
import { LINKS } from '../data/site';
---

<section class="relative isolate overflow-hidden">
	<!-- Subtle engineering grid + brand glow -->
	<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
		<div
			class="absolute inset-0 opacity-[0.55]"
			style="background-image: linear-gradient(to right, rgb(13 21 38 / 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgb(13 21 38 / 0.05) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 30%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 30%, transparent 75%);"
		></div>
		<div class="absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-brand-600/15 blur-3xl"></div>
	</div>

	<div class="mx-auto grid max-w-6xl items-center gap-14 px-5 pb-20 pt-16 sm:px-8 sm:pt-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10 lg:pb-28 lg:pt-24">
		<div>
			<p class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/80 py-1 pl-1.5 pr-3.5 text-xs font-medium text-ink-700 shadow-sm backdrop-blur" data-reveal>
				<span class="inline-flex items-center gap-1 rounded-full bg-on-soft px-2 py-0.5 text-[11px] font-semibold text-[#067a0a]">
					<span class="size-1.5 rounded-full bg-on animate-pulse-soft"></span>30-day free trial
				</span>
				For teams running AWS or Azure
			</p>
			<h1 class="h-display mt-6 text-[2.6rem] leading-[1.04] sm:text-6xl lg:text-[4.25rem]" data-reveal style="--reveal-delay: 60ms">
				Stop paying for cloud servers nobody is using.
			</h1>
			<p class="mt-6 max-w-xl text-lg leading-8 text-ink-500 sm:text-xl sm:leading-9" data-reveal style="--reveal-delay: 120ms">
				CLOUD TOGGLE switches your AWS and Azure servers off when they're not needed and back on when they are, on schedules you set up in minutes.
			</p>
			<div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal style="--reveal-delay: 180ms">
				<Button href={LINKS.trial} size="lg">
					Start Free Trial
					<svg viewBox="0 0 16 16" class="size-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
				</Button>
				<Button href={LINKS.demo} variant="secondary" size="lg" external>Book a Demo</Button>
			</div>
			<ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-500" data-reveal style="--reveal-delay: 240ms">
				<li class="flex items-center gap-2"><svg viewBox="0 0 16 16" class="size-4 text-on" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>No engineering skills needed</li>
				<li class="flex items-center gap-2"><svg viewBox="0 0 16 16" class="size-4 text-on" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>Plans from $49 a month</li>
				<li class="flex items-center gap-2"><svg viewBox="0 0 16 16" class="size-4 text-on" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>Override any schedule in seconds</li>
			</ul>
		</div>

		<div class="relative" data-reveal style="--reveal-delay: 160ms">
			<div class="absolute -inset-6 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-200/60 via-transparent to-on/10 blur-2xl" aria-hidden="true"></div>
			<BrowserFrame
				src={scheduler}
				alt="The CLOUD TOGGLE schedule editor showing a UK Working Hours schedule: servers on from 09:00 to 19:00, Monday to Friday, and off all other hours."
				label="CLOUD TOGGLE · Edit schedule"
				loading="eager"
				sizes="(min-width: 1024px) 480px, 92vw"
				class="lg:rotate-[0.6deg]"
			/>
			<div class="absolute -bottom-6 left-4 right-4 sm:left-auto sm:right-[-1.25rem] sm:w-72" >
				<div class="rounded-xl border border-ink-200 bg-white/95 p-4 shadow-window backdrop-blur">
					<p class="font-mono text-[11px] uppercase tracking-wider text-ink-400">This schedule</p>
					<p class="mt-1 text-sm text-ink-700">
						On <strong class="font-semibold text-ink-950">50 of 168</strong> hours a week.
						<span class="text-ink-500">Off the other</span> <strong class="font-semibold text-[#067a0a]">118 hours, 70% of the week.</strong>
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
