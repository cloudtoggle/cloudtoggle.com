---
import SectionHeading from './SectionHeading.astro';
import { FAQS } from '../data/site';
---

<section id="faq" class="py-24 sm:py-28">
	<div class="mx-auto max-w-3xl px-5 sm:px-8">
		<SectionHeading eyebrow="FAQ" title="Questions, answered." />
		<div class="mt-12 divide-y divide-ink-100 border-y border-ink-100" data-reveal>
			{FAQS.map((f) => (
				<details class="group py-5">
					<summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-left text-lg font-medium text-ink-950 [&::-webkit-details-marker]:hidden">
						{f.q}
						<span class="mt-1.5 inline-flex size-5 shrink-0 items-center justify-center text-ink-400 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
							<svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
						</span>
					</summary>
					<p class="mt-3 max-w-2xl pr-10 leading-7 text-ink-500">{f.a}</p>
				</details>
			))}
		</div>
	</div>
</section>
