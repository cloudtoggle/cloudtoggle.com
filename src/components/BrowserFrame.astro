---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	label?: string;
	loading?: 'lazy' | 'eager';
	sizes?: string;
	class?: string;
}
const { src, alt, label = 'app.cloudtoggle.com', loading = 'lazy', sizes = '(min-width: 1024px) 560px, 100vw', class: className = '' } = Astro.props;
---

<figure class:list={['overflow-hidden rounded-2xl border border-ink-200/80 bg-white shadow-window', className]}>
	<div class="flex h-10 items-center gap-3 border-b border-ink-100 bg-ink-50 px-4" aria-hidden="true">
		<div class="flex gap-1.5">
			<span class="size-2.5 rounded-full bg-ink-200"></span>
			<span class="size-2.5 rounded-full bg-ink-200"></span>
			<span class="size-2.5 rounded-full bg-ink-200"></span>
		</div>
		<div class="mx-auto flex h-6 w-full max-w-xs items-center justify-center rounded-md bg-white font-mono text-[11px] text-ink-400 ring-1 ring-ink-100">
			{label}
		</div>
		<div class="w-10"></div>
	</div>
	<Image src={src} alt={alt} {loading} {sizes} widths={[480, 640, 844]} class="block h-auto w-full" />
</figure>
