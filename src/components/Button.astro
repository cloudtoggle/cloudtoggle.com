---
interface Props {
	href: string;
	variant?: 'primary' | 'secondary' | 'ghost' | 'light';
	size?: 'md' | 'lg';
	class?: string;
	external?: boolean;
}
const { href, variant = 'primary', size = 'md', class: className = '', external = false } = Astro.props;

const base =
	'group inline-flex items-center justify-center gap-2 rounded-full font-medium whitespace-nowrap transition duration-200 active:scale-[0.98]';
const sizes = { md: 'h-10 px-5 text-sm', lg: 'h-12 px-7 text-base' };
const variants = {
	primary: 'bg-brand-600 text-white shadow-[0_1px_0_rgb(255_255_255/0.25)_inset,0_6px_18px_-6px_rgb(21_120_224/0.6)] hover:bg-brand-700',
	secondary: 'border border-ink-200 bg-white text-ink-900 shadow-sm hover:border-ink-400 hover:bg-ink-50',
	ghost: 'text-ink-700 hover:text-ink-950',
	light: 'bg-white text-ink-950 hover:bg-brand-50',
};
const rel = external ? 'noopener' : undefined;
---

<a href={href} rel={rel} class:list={[base, sizes[size], variants[variant], className]}>
	<slot />
</a>
