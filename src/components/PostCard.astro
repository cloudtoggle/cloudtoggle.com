---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, image, imageAlt, readingTime } = post.data;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-card transition duration-300 hover:-translate-y-1 hover:border-brand-200">
	<div class="aspect-[16/9] overflow-hidden bg-ink-50">
		{image ? (
			<img src={image} alt={imageAlt ?? ''} loading="lazy" decoding="async" width="1312" height="736" class="size-full object-cover transition duration-500 group-hover:scale-[1.03]" />
		) : (
			<div class="flex size-full items-center justify-center bg-gradient-to-br from-brand-50 to-ink-50 font-mono text-xs text-ink-400">CLOUD TOGGLE</div>
		)}
	</div>
	<div class="flex flex-1 flex-col p-6">
		<p class="font-mono text-xs text-ink-400">
			<time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>{readingTime && <span> · {readingTime}</span>}
		</p>
		<h2 class="mt-3 text-lg font-semibold leading-snug tracking-tight text-ink-950">
			<a href={`/blog-en/${post.id}/`} class="after:absolute after:inset-0">{title}</a>
		</h2>
		<p class="mt-2 line-clamp-3 text-sm leading-6 text-ink-500">{description}</p>
	</div>
</article>
